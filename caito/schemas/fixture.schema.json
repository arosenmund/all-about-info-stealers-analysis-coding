{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hybrid-edge-classifier.local/schemas/fixture-001.json",
  "title": "Labeled synthetic or evaluation fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_schema_version", "record", "annotation", "group_id", "template_id", "generated_by"],
  "properties": {
    "fixture_schema_version": {"const": "fixture-001"},
    "record": {"$ref": "input.schema.json"},
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_label"],
      "properties": {
        "primary_label": {
          "enum": ["sensitive_like", "placeholder_or_test", "benign_other"]
        },
        "artifact_family": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "group_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "template_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "generated_by": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}

