<?xml version='1.1' encoding='UTF-8'?>
<!-- $JENKINS_HOME\credentials.xml on a Windows controller (e.g.
     C:\ProgramData\Jenkins\.jenkins\credentials.xml).
     {AQAAABAAAAAg...} values are AES-encrypted with the key in
     $JENKINS_HOME\secrets\hudson.util.Secret + master.key -> decryptable
     offline if you also grab those two files. -->
<com.cloudbees.plugins.credentials.SystemCredentialsProvider plugin="credentials@1254">
  <domainCredentialsMap class="hudson.util.CopyOnWriteMap$Hash">
    <entry>
      <com.cloudbees.plugins.credentials.domains.Domain>
        <specifications/>
      </com.cloudbees.plugins.credentials.domains.Domain>
      <java.util.concurrent.CopyOnWriteArrayList>
        <com.cloudbees.plugins.credentials.impl.UsernamePasswordCredentialsImpl>
          <id>deploy-svc</id>
          <description>Prod deploy service account</description>
          <username>svc_deploy</username>
          <password>{AQAAABAAAAAgW1nt3rBackup2026FakeEncryptedBlobABCDEF0123456789==}</password>
        </com.cloudbees.plugins.credentials.impl.UsernamePasswordCredentialsImpl>
        <com.cloudbees.plugins.credentials.impl.StringCredentialsImpl>
          <id>github-pat</id>
          <description>GitHub deploy token</description>
          <secret>{AQAAABAAAAAwghpAbCdEfGhIjKlMnOpQrStUvWxYzFakeEncrypted0123456789==}</secret>
        </com.cloudbees.plugins.credentials.impl.StringCredentialsImpl>
      </java.util.concurrent.CopyOnWriteArrayList>
    </entry>
  </domainCredentialsMap>
</com.cloudbees.plugins.credentials.SystemCredentialsProvider>
