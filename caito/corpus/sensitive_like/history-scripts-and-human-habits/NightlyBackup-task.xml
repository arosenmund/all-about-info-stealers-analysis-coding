<?xml version="1.0" encoding="UTF-16"?>
<!-- C:\Windows\System32\Tasks\NightlyBackup  (an XML file, no extension).
     When a task "Run whether user is logged on or not" stores a password, it
     goes to the Credential Manager as a DPAPI blob under SYSTEM — BUT the task
     Arguments below leak the SQL password in plaintext regardless. -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>EXAMPLE\jdoe</Author>
    <Description>Nightly payroll DB backup</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-01T02:00:00</StartBoundary>
      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>EXAMPLE\svc_backup</UserId>
      <LogonType>Password</LogonType>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</Command>
      <Arguments>-NoProfile -Command "sqlcmd -S sqlprod01.example.com -U sa -P 'S3rver-SQL-2026#Payroll' -Q \"BACKUP DATABASE Payroll TO DISK='D:\bak\payroll.bak'\""</Arguments>
    </Exec>
  </Actions>
</Task>
